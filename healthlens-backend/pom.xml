<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- 
        1. PARENT POM (The Foundation)
        ================================
        Spring Boot provides a "parent" POM that handles:
        - Default Java version (17)
        - Compatible dependency versions
        - Common plugin configurations
        - Default encoding (UTF-8)
        
        Without this, you'd manually manage 50+ dependency versions!
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- Look up in Maven repository -->
    </parent>
    
    <!-- 
        2. PROJECT IDENTITY
        ===================
        These uniquely identify your project in the world
    -->
    <groupId>com.healthlens</groupId>      <!-- Your organization's reverse domain -->
    <artifactId>healthlens-backend</artifactId>  <!-- Project name -->
    <version>1.0.0</version>                <!-- Version (SemVer: MAJOR.MINOR.PATCH) -->
    <name>HealthLens AI Backend</name>
    <description>Healthcare Risk Prediction API</description>
    
    <!-- 
        3. PROPERTIES (Variables)
        =========================
        Define reusable values. Reference them as ${property.name}
    -->
    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.3</jjwt.version>
    </properties>
    
    <!-- 
        4. DEPENDENCIES (The Libraries You Need)
        ========================================
        Maven downloads these automatically from Maven Central repository
        Format: groupId:artifactId:version
    -->
    <dependencies>
        
        <!-- 
            A. WEB CAPABILITIES
            -------------------
            spring-boot-starter-web includes:
            - Embedded Tomcat server (runs on port 8080)
            - Spring MVC (for REST controllers)
            - Jackson (JSON serialization)
            - Validation support
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- 
            B. DATABASE ACCESS (JPA)
            ------------------------
            spring-boot-starter-data-jpa includes:
            - Spring Data JPA (simplifies database operations)
            - Hibernate (ORM - maps Java objects to SQL tables)
            - Transaction management
            - Connection pooling (HikariCP by default)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- 
            C. MYSQL CONNECTOR
            ------------------
            The actual driver that connects Java to MySQL
            'runtime' scope = only needed when running, not compiling
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- 
            D. SECURITY
            -----------
            spring-boot-starter-security includes:
            - Authentication & authorization framework
            - Password encoding (BCrypt)
            - CSRF protection
            - Session management
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
        <!-- 
            E. JWT (JSON Web Tokens)
            ------------------------
            Used for stateless authentication:
            - User logs in → receives JWT token
            - Client sends token in header for subsequent requests
            - Server validates token signature (no session needed)
            
            We need 3 parts: API (interfaces), Implementation, and JSON parsing
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        
        <!-- 
            F. VALIDATION
            -------------
            @NotNull, @Email, @Size annotations
            Validates request data automatically before reaching controller
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- 
            G. LOMBOK (Optional but Recommended)
            ------------------------------------
            Reduces boilerplate code:
            - @Data generates getters, setters, toString, equals, hashCode
            - @Builder creates builder pattern
            - @Slf4j adds logging
            
            'optional=true' = don't force this on dependent projects
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- 
            H. TESTING
            ----------
            For unit and integration tests
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <!-- 
        5. BUILD PLUGINS
        ================
        Tools that run during build process
    -->
    <build>
        <plugins>
            <!-- 
                Spring Boot Maven Plugin:
                - Creates executable JAR (java -jar app.jar)
                - Embeds Tomcat (no separate server needed)
                - Manages dependency versions
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Don't package Lombok in final JAR -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>